<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bored API Demo</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">
    <h1>Let's Find Something To Do</h1>

    <form action="/filter" method="POST" class="filter-form">
      <select name="type">
        <option value="">Any Type</option>
        <option value="education">Education</option>
        <option value="recreational">Recreational</option>
        <option value="social">Social</option>
        <option value="charity">Charity</option>
        <option value="cooking">Cooking</option>
        <option value="relaxation">Relaxation</option>
        <option value="busywork">Busywork</option>
      </select>

      <select name="participants">
        <option value="">Any Number of People</option>
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
      </select>

      <button type="submit">Filter Activity</button>
      <a href="/" class="btn-random">Random</a>
    </form>

    <div class="card">
      <% if (data) { %>
        <h2><%= data.activity %></h2>
        <div class="meta">
          <span><strong>Type:</strong> <%= data.type %></span>
          <span><strong>Participants:</strong> <%= data.participants %></span>
          <span><strong>Price:</strong> <%= data.price %></span>
        </div>
      <% } else if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>
    </div>
  </div>
</body>
</html>